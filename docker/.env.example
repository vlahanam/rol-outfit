DB_USER=
DB_PASSWORD=
DB_NAME=

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Settings
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost/login/callback
OAUTH_CALLBACK_BASE_URL=http://localhost

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

UPLOAD_DRIVER=local

# SMTP - Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=roloutfit@gmail.com
ADMIN_EMAIL=roloutfit@gmail.com

# Bill reminder cronjob (daily at 10:00 JST)
BILL_REMINDER_TIME=10:00
BILL_REMINDER_ENABLED=true
